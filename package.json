{
  "name": "adeptix",
  "version": "0.2.0",
  "description": "Official Node.js / TypeScript SDK for the Adeptix API — crypto payments and merchant payments.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test test/**/*.test.ts",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "adeptix",
    "payments",
    "crypto",
    "payment-gateway",
    "api-client"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adeptix-app/adeptix-node.git"
  },
  "homepage": "https://docs.adeptix.app",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.3"
  }
}
